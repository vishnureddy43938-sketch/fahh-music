# ============================================================
# HYDRA DISCORD MUSIC BOT - ENVIRONMENT CONFIGURATION
# ============================================================

# Discord Bot Credentials (Required)
# Retrieve these from https://discord.com/developers/applications
DISCORD_TOKEN=
CLIENT_ID=

# Bot Owner & Prefix Settings
OWNER_ID=1545399010444185681
BOT_PREFIX=?

# Development Guild ID (Optional)
# If provided, commands will be deployed instantly to this guild instead of globally.
GUILD_ID=

# Support Server & Community Links
SUPPORT_SERVER_URL=https://discord.gg/U465TGfT9Z
INVITE_URL=

# Database Configuration
DATABASE_PATH=./data/hydra.sqlite

# Default Music Engine Settings
DEFAULT_VOLUME=100
DEFAULT_IDLE_TIMEOUT=180
MAX_QUEUE_SIZE=500

# ============================================================
# LAVALINK NODE CONFIGURATION
# ============================================================
NODE_URL=noi6.visihost.in:25591
NODE_NAME=Lava Lenin
NODE_AUTH=
NODE_SECURE=false

# Optional Lyrics Integration (Genius API Client Token)
GENIUS_API_KEY=

# ============================================================
# WEB DASHBOARD CONFIGURATION (OPTIONAL)
# ============================================================
DASHBOARD_ENABLED=false
DASHBOARD_PORT=3000
DASHBOARD_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_random_secure_secret_string

# Discord OAuth2 for Web Dashboard
# Required only if DASHBOARD_ENABLED=true
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_CALLBACK_URL=http://localhost:3000/api/auth/callback
